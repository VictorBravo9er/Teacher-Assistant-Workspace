{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python Debugger: Current File - system python",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "python": "/usr/bin/python"
    },
    {
      "name": "pnpm install && pnpm run dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm install && pnpm run dev"
    }
  ]
}

# ==============================================================================
# Teach&Learn Frontend Web App — Environment Variables Template
# Copy this file to frontend/.env for standalone frontend development
# ==============================================================================

# Supabase Client Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Client Observability & Logging (Stored in localStorage and exported via logger.ts)
VITE_LOG_LEVEL=DEBUG
VITE_LOG_MAX_ENTRIES=5000

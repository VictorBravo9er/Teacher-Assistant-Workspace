# ==============================================================================
# Teach&Learn Platform — Unified Environment Variables Template
# Copy this file to .env or .env.local for local execution
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Docker Compose & Networking
# ------------------------------------------------------------------------------
HOST_PORT=80
FRONTEND_PORT=8080
BACKEND_PORT=8090
COMPOSE_FILE=docker-compose.yml

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Frontend & Backend)
# ------------------------------------------------------------------------------
# Frontend client Supabase endpoint and anonymous public key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Optional: Explicit project reference for CLI operations (otherwise derived from URL)
SUPABASE_PROJECT_REF=your-project-ref
# Required for non-interactive `supabase db push` / `supabase functions deploy`
SUPABASE_ACCESS_TOKEN=sbp_your_supabase_personal_access_token

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Connections
# ------------------------------------------------------------------------------
# Direct PostgreSQL connection string (transaction pooling or direct port 5432)
POSTGRES_URI=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
# Search path options for LangGraph checkpoints (isolated memory schema)
DB_OPTIONS=-c%20search_path%3Dlanggraph

# ------------------------------------------------------------------------------
# 4. AI & LLM Providers (OpenRouter / LangChain)
# ------------------------------------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ------------------------------------------------------------------------------
# 5. Notifications & Email Dispatch (Resend & Edge Functions)
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=notifications@yourdomain.com
RESEND_WEBHOOK_SECRET=whsec_your_resend_webhook_secret

# ------------------------------------------------------------------------------
# 6. Logging & Observability
# ------------------------------------------------------------------------------
LOG_MAX_ENTRIES=5000
VITE_LOG_MAX_ENTRIES=5000
VITE_LOG_LEVEL=DEBUG

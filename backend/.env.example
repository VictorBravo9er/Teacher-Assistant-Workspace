# ==============================================================================
# Teach&Learn Backend Service — Environment Variables Template
# Copy this file to backend/.env for standalone backend development
# ==============================================================================

# Server Network Configuration
BACKEND_PORT=8090

# PostgreSQL Database & LangGraph State Store
POSTGRES_URI=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
DB_OPTIONS=-c%20search_path%3Dlanggraph

# LLM Gateway (OpenRouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Observability & Logging (Cohorts of 5000 entries rotated across .jsonl and .log)
LOG_MAX_ENTRIES=5000
